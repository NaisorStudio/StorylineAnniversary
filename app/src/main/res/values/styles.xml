<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema de arranque: Usa el tema base de Material3 directamente -->
    <style name="Theme.App.Starting" parent="android:Theme.Material.NoActionBar">
        <!-- Quitar barra de título -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>

        <!-- Fondo negro directo desde el inicio -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Tema base de tu app usando Material 3 nativo -->
    <style name="Theme.StorylineAnniversary" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>